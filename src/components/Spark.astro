---
// Tiny trend line for stat tiles. Decorative: the numbers are stated in text beside it.
interface Props { values: number[] }
const { values } = Astro.props;
const W = 120, H = 32, p = 4;
const lo = Math.min(...values), hi = Math.max(...values), span = hi - lo || 1;
const pt = (v: number, i: number) => [p + (i * (W - 2 * p)) / (values.length - 1), H - p - ((v - lo) / span) * (H - 2 * p)];
const d = values.map((v, i) => `${i ? 'L' : 'M'}${pt(v, i).map((n) => n.toFixed(1)).join(',')}`).join('');
const [ex, ey] = pt(values[values.length - 1], values.length - 1);
---
<svg class="spark" viewBox={`0 0 ${W} ${H}`} width={W} height={H} aria-hidden="true">
  <path d={d} fill="none" stroke="var(--viz-muted)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
  <circle cx={ex} cy={ey} r="4" fill="var(--viz-1)" stroke="var(--color-card)" stroke-width="2" />
</svg>
