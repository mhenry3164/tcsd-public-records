---
import Base from '../../layouts/Base.astro';
import { docs } from '../../lib/documents';
import { fmtDate } from '../../lib/format';
const groups = [
  ['audits', 'Tishomingo County School District audits', 'Audited financial statements filed with the Mississippi Office of the State Auditor. The source of every figure on the Finances pages.'],
  ['peer-audits', 'Neighboring districts’ audits', 'The latest audits of six neighboring districts, used on the Benchmarks page.'],
  ['records', 'Records and rulings', 'Orders and responses about public access to district records.'],
  ['budget', 'Budget documents', 'Adopted budgets, when the district provides them.'],
] as const;
---
<Base title="Documents" description="Every PDF the TCSD Public Record takes a number from — district audits FY2022–FY2025, six neighboring districts’ audits, and an Ethics Commission order — viewable in the page, searchable, and downloadable.">
  <h1 class="text-[clamp(1.9rem,1.2rem+2vw,3rem)] leading-tight font-semibold">Documents</h1>
  <p class="mt-3">Any PDF this site takes a number from can be read here, page by page, and downloaded. Each one opens with a short plain-language summary. The full text of every page is searchable from <a href="/search">Search</a>.</p>
  {groups.map(([key, title, blurb]) => {
    const list = docs.filter((d) => d.collection === key);
    return (
      <section class="mt-8">
        <h2 class="text-xl font-semibold">{title}</h2>
        <p class="mt-1 text-sm text-muted">{blurb}</p>
        {list.length ? (
          <ul class="mt-3 divide-y divide-rule border-y border-rule">
            {list.map((d) => (
              <li class="py-3 flex flex-wrap justify-between gap-x-4">
                <a href={`/documents/${d.id}`} class="font-medium">{d.title}</a>
                <span class="text-sm text-muted">{d.author} · {fmtDate(d.reportDate)} · {d.pages} pp. · <a href={d.file} download>PDF</a></span>
              </li>
            ))}
          </ul>
        ) : <p class="mt-3 text-sm">None yet. The adopted budget has not been made public; see <a href="/records">Missing records</a>.</p>}
      </section>
    );
  })}
</Base>
