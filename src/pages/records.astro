---
import Base from '../layouts/Base.astro';
import requests from '../data/records-requests.json';
import calendar from '../data/meetings-calendar.json';
import policies from '../data/policies.json';
import site from '../data/site.json';
import { reportByDate } from '../lib/meetings';
import { fmtDate } from '../lib/format';
import { docHref } from '../lib/documents';
import ext from '../data/external-search.json';
const order = 'records/ethics-m-25-022';
const past = calendar.filter((m) => m.date <= site.dataPulled);
const privateCount = past.filter((m) => !m.minutesPublic).length;
const unreported = past.filter((m) => !reportByDate.has(m.date));
const pol = (code: string) => policies.find((p) => p.code === code)!;
type Req = { sent: string; to: string; items: string[]; responseDue: string; status: string; responseSummary?: string; files?: { label: string; href: string }[] };
const log = requests as Req[];
---
<Base title="Missing records" description="Records of the Tishomingo County School District that are not public online — board minutes, agendas, packets, the adopted budget, claims dockets — and the log of public-records requests.">
  <h1 class="text-[clamp(1.9rem,1.2rem+2vw,3rem)] leading-tight font-semibold">Missing records</h1>
  <p class="mt-3 measure">What the district has not made public online, and what has been requested under the Mississippi Public Records Act (Miss. Code § 25-61). District policy <a href={pol('CNA').url}>CNA, Access to Public Records</a> governs requests; policy <a href={pol('BCBH').url}>BCBH, Minutes of Board Meetings</a> governs what the minutes record.</p>

  <section class="mt-8">
    <h2 class="text-xl font-semibold">Not public online</h2>
    <div class="table-wrap mt-3">
      <table class="data">
        <thead><tr><th>Record</th><th>Status</th><th>Where it should be</th></tr></thead>
        <tbody>
          <tr><td>Board minutes</td><td>Private on OAgendas for all {privateCount} meetings from {fmtDate(past[0].date)} to {fmtDate(past[past.length - 1].date)}. The board confirmed to the Ethics Commission that it does not post minutes online, and said copies are provided on request (<a href={docHref(order, 2)}>Order M-25-022</a>).</td><td>Superintendent’s office, for inspection or copies; <a href={site.district.oagendas}>OAgendas</a> (login required)</td></tr>
          <tr><td>Agendas and board packets</td><td>Private on OAgendas for the same meetings; only the meeting notice is public.</td><td><a href={site.district.oagendas}>OAgendas</a></td></tr>
          <tr><td>Adopted budget document (FY2026, FY2027)</td><td>Not posted on the district website. The FY2027 budget hearing was held July 21, 2026.</td><td><a href={site.district.website}>District website</a></td></tr>
          <tr><td>Claims dockets / check register</td><td>Only annual vendor totals (2023–2024) are available, via OpenTheBooks. The monthly claims dockets the board approves are not public.</td><td>District business office</td></tr>
          <tr><td>Outcomes of meetings the newspaper did not cover</td><td>{unreported.length} of {past.length} meetings since Sept. 2024 have no newspaper report, including special-called meetings on June 2, June 30 and Sept. 2, 2026.</td><td>Minutes</td></tr>
          <tr><td>Individual members’ votes</td><td>Printed by the newspaper on only a handful of items. Policy BCBH requires the minutes to record each member’s vote.</td><td>Minutes</td></tr>
        </tbody>
      </table>
    </div>
    <p class="source mt-1">Sources: <a href={site.district.oagendas}>OAgendas meeting list</a>, checked {fmtDate(site.dataPulled)}; <a href="/meetings">meeting calendar on this site</a>.</p>
  </section>

  <section class="mt-10" id="minutes-ruling">
    <h2 class="text-xl font-semibold">Are the minutes public?</h2>
    <p class="mt-2 measure">Yes, by inspection and on request. No, not online, and state law does not require them to be. That is the holding of the Mississippi Ethics Commission in Open Meetings Case No. M-25-022, dismissed May 8, 2026, on a complaint by a private citizen against the board.</p>
    <ul class="mt-3 list-disc pl-6 space-y-2 measure">
      <li>The Open Meetings Act (Miss. Code § 25-41-11) requires minutes to be recorded within 30 days of a meeting and “open to public inspection during regular business hours.” It “does not require minutes be posted online.” (¶2.2)</li>
      <li>The board “confirms that the board does not post its minutes online.” (¶1.3)</li>
      <li>District policy BCBH: “Minutes shall be kept on file in the office of the superintendent and open to public inspection during regular business hours.” (¶1.3)</li>
      <li>The district told the Commission that copies of board minutes “would have been provided as per policy” if requested. (¶1.4)</li>
      <li>The Commission restated the standard: the Act “is to be construed liberally in favor of the public,” and “however inconvenient openness may be to some, it is the legislatively decreed public policy of this state.” (¶2.1)</li>
    </ul>
    <p class="source mt-2">Source: <a href={docHref(order)}>Mississippi Ethics Commission, Order of Dismissal, Case No. M-25-022 (May 8, 2026)</a> — read or download the full two-page order.</p>
  </section>

  <section class="mt-10" id="looked-for">
    <h2 class="text-xl font-semibold">What we looked for</h2>
    <p class="mt-2 measure">A search for any other state or federal proceeding involving the district, checked {fmtDate(ext.checked)}. Empty results are listed so readers can see what was checked.</p>
    <div class="table-wrap mt-3">
      <table class="data">
        <thead><tr><th>Source</th><th>How searched</th><th>Result</th></tr></thead>
        <tbody>{ext.searched.map(([src, how, res, href]) => <tr><td>{src}</td><td>{how}</td><td>{res}{href && <> <a href={href}>See it on this site.</a></>}</td></tr>)}</tbody>
      </table>
    </div>
    <h3 class="mt-4 font-semibold">Not reachable from public indexes</h3>
    <ul class="mt-2 list-disc pl-6 space-y-1 measure">{ext.notReachable.map((x) => <li>{x}</li>)}</ul>
    <p class="source mt-2">Source: searches of each body’s public database on {fmtDate(ext.checked)}.</p>
  </section>

  <section class="mt-10">
    <h2 class="text-xl font-semibold">Records-request log</h2>
    <p class="mt-2 measure">Requests go to the Superintendent, Tishomingo County School District, 1620 Paul Edmondson Drive, Iuka, MS 38852. Under policy CNA the district has seven working days to respond.</p>
    {log.length ? (
      <div class="table-wrap mt-3">
        <table class="data">
          <thead><tr><th>Sent</th><th>To</th><th>Requested</th><th>Response due</th><th>Status</th><th>Response</th></tr></thead>
          <tbody>{log.map((r) => (
            <tr><td class="whitespace-nowrap">{fmtDate(r.sent)}</td><td>{r.to}</td><td><ul class="list-disc pl-4">{r.items.map((i) => <li>{i}</li>)}</ul></td>
              <td class="whitespace-nowrap">{fmtDate(r.responseDue)}</td><td>{r.status}</td>
              <td>{r.responseSummary ?? '—'}{r.files?.map((f) => <> <a href={f.href}>{f.label}</a></>)}</td></tr>
          ))}</tbody>
        </table>
      </div>
    ) : <p class="note mt-3">No requests have been logged yet. This table will list each request, its due date, and the district’s response.</p>}
  </section>
</Base>
