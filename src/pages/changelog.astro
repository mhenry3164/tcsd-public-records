---
import Base from '../layouts/Base.astro';
import log from '../data/changelog.json';
import site from '../data/site.json';
import { fmtDate } from '../lib/format';
---
<Base title="Changelog" description="What changed on the TCSD Public Record at each quarterly update.">
  <h1 class="text-[clamp(1.9rem,1.2rem+2vw,3rem)] leading-tight font-semibold">Changelog</h1>
  <p class="mt-3 measure">{site.updateSchedule}</p>
  {log.map((e) => (
    <section class="mt-8 card measure">
      <p class="eyebrow">{fmtDate(e.date, true)}</p>
      <h2 class="text-xl font-semibold mt-1">{e.title}</h2>
      <ul class="mt-2 list-disc pl-6 space-y-1">{e.items.map((i) => <li>{i}</li>)}</ul>
    </section>
  ))}
</Base>
