---
import Base from '../../layouts/Base.astro';
import Source from '../../components/Source.astro';
import hearings from '../../data/budget-hearings.json';
import { getCollection } from 'astro:content';
import { fmtDate } from '../../lib/format';
const budgetNotices = (await getCollection('notices', (n) => n.data.kind === 'budget')).sort((a, b) => +b.data.date - +a.data.date);
---
<Base title="Budget" description="Tishomingo County School District budget hearings by year — enrollment, staff, millage, federal relief — and the published budget and tax-effort legal notices in full.">
  <p class="text-sm"><a href="/finances">← Finances</a></p>
  <h1 class="text-[clamp(1.9rem,1.2rem+2vw,3rem)] leading-tight font-semibold mt-2">Budget</h1>
  <p class="note mt-4">The adopted budget document itself is not posted on the district website. What is public: the facts presented at the annual budget hearing as reported by the newspaper, and the budget legal notices the district must publish. See <a href="/records">Missing records</a>.</p>

  {hearings.map((h) => (
    <section class="mt-8">
      <h2 class="text-xl font-semibold">{h.schoolYear} budget hearing · {fmtDate(h.hearingDate)}</h2>
      <div class="table-wrap mt-3"><table class="data">
        <tbody>{h.facts.map((f) => <tr><th scope="row" class="w-1/3">{f.label}</th><td>{f.value}</td></tr>)}</tbody>
      </table></div>
      <Source src={h.source} />
    </section>
  ))}

  <section class="mt-10">
    <h2 class="text-xl font-semibold">Budget legal notices</h2>
    {budgetNotices.length ? (
      <ul class="mt-3 space-y-3">{budgetNotices.map((n) => (
        <li><a href={`/notices/${n.id}`} class="font-medium">{n.data.title}</a> <span class="text-muted text-sm">· first published {fmtDate(n.data.date)}</span><br /><span class="text-sm">{n.data.summary}</span></li>
      ))}</ul>
    ) : <p class="mt-2">No budget notices have been transcribed yet.</p>}
  </section>
</Base>
